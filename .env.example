# --- IMAP (incoming mail) ---
# Hostname of your IMAP server. Examples:
#   imap.mailbox.org, imap.fastmail.com, imap.mail.me.com, mail.example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# For Gmail, iCloud, Fastmail, etc. use an app-specific password — NOT your
# main account password. Two-factor providers refuse plain logins via IMAP.
IMAP_PASS=
# true = implicit TLS on connect (993). false = STARTTLS on 143.
IMAP_TLS=true

# --- SMTP (outgoing mail) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# true = implicit TLS (465). false = STARTTLS on 587 (most modern hosts).
SMTP_TLS=true

# Default From: header on send_message. Plain address — display name optional.
DEFAULT_FROM=
DEFAULT_FROM_NAME=

# IMAP folder where create_draft appends. Server-specific:
#   Mailbox.org/IMAP-standard: "Drafts"
#   Gmail: "[Gmail]/Drafts"
DRAFTS_FOLDER=Drafts
# IMAP folder where sent messages are copied after send_message. Set empty to skip.
SENT_FOLDER=Sent

# --- CalDAV (calendar) ---
# CalDAV principal URL. Examples:
#   Fastmail:    https://caldav.fastmail.com/dav/principals/user/USER@fastmail.com/
#   Mailbox.org: https://dav.mailbox.org/caldav/
#   iCloud:      https://caldav.icloud.com/
#   Nextcloud:   https://cloud.example.com/remote.php/dav/principals/users/USER/
# Leave CALDAV_URL empty to disable calendar tools entirely.
CALDAV_URL=
CALDAV_USER=
CALDAV_PASS=

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# v0.1 single-tenant: one shared secret per deployment.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# --- Server ---
PUBLIC_URL=https://mcp-mail.example.com
PORT=3220
# debug | info | warn | error
LOG_LEVEL=info
